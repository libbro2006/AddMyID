---
import Layout from '../../layouts/Layout.astro';
import WalletCard from '../../components/WalletCard.astro';
import { getCollection } from '../../utils/states';

export async function getStaticPaths() {
  const states = await getCollection();
  return states.map((state) => ({
    params: { state: state.slug },
    props: { state },
  }));
}

const { state } = Astro.props;

const statusLabel =
  state.mdl_status === 'live'
    ? 'Digital ID available'
    : state.mdl_status === 'coming_soon'
    ? 'Coming soon'
    : 'Not yet available';

const statusClass =
  state.mdl_status === 'live'
    ? 'bg-green-50 text-green-700 border border-green-200'
    : state.mdl_status === 'coming_soon'
    ? 'bg-amber-50 text-amber-700 border border-amber-200'
    : 'bg-gray-50 text-gray-500 border border-gray-200';
---

<Layout
  title={`${state.name} Digital ID — AddMyID`}
  description={`How to add a ${state.name} digital ID or mDL to Apple Wallet, Google Wallet, or the ${state.name} state app.`}
>
  <div class="mx-auto max-w-2xl px-4 py-12">
    <a href="/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-brand-600 transition-colors mb-8">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      All states
    </a>

    <div class="flex flex-wrap items-start justify-between gap-4 mb-2">
      <h1 class="font-serif text-3xl font-semibold text-gray-900">{state.name}</h1>
      <span class={`rounded-full px-3 py-1 text-sm font-medium ${statusClass}`}>
        {statusLabel}
      </span>
    </div>

    {state.notes && (
      <p class="mt-3 mb-8 text-gray-500 text-sm leading-relaxed">{state.notes}</p>
    )}

    {!state.notes && <div class="mb-8"></div>}

    {state.mdl_status === 'not_available' ? (
      <div class="rounded-xl border border-gray-100 bg-white p-8 text-center text-gray-500">
        <p class="text-lg">Digital ID is not yet available in {state.name}.</p>
        <p class="mt-2 text-sm">Check back later — many states are actively working on mDL programs.</p>
      </div>
    ) : (
      <div class="space-y-3">
        {state.wallets.map((wallet) => (
          <WalletCard wallet={wallet} />
        ))}
      </div>
    )}

    <p class="mt-8 text-xs text-gray-400 text-right">Last updated: {state.last_updated}</p>
  </div>
</Layout>
