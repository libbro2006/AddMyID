---
import Layout from '../../layouts/Layout.astro';
import WalletCard from '../../components/WalletCard.astro';
import { getCollection } from '../../utils/states';

export async function getStaticPaths() {
  const states = await getCollection();
  return states.map((state) => ({
    params: { state: state.slug },
    props: { state },
  }));
}

const { state } = Astro.props;

const stateSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `${state.name} Digital ID — AddMyID`,
  url: `https://addmyid.info/state/${state.slug}`,
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://addmyid.info' },
      { '@type': 'ListItem', position: 2, name: `${state.name} Digital ID`, item: `https://addmyid.info/state/${state.slug}` },
    ],
  },
});

const statusLabel =
  state.mdl_status === 'live'
    ? 'Digital ID available'
    : state.mdl_status === 'coming_soon'
    ? 'Coming soon'
    : 'Not yet available';

const statusClass =
  state.mdl_status === 'live'
    ? 'bg-green-50 text-green-700 border border-green-200'
    : state.mdl_status === 'coming_soon'
    ? 'bg-amber-50 text-amber-700 border border-amber-200'
    : 'bg-gray-50 text-gray-500 border border-gray-200';
---

<Layout
  title={`${state.name} Digital ID — AddMyID`}
  description={
    state.mdl_status === 'not_available'
      ? `${state.name} doesn't have a digital ID program yet. Learn how to encourage your state legislators to support mobile driver's licenses.`
      : `How to add a ${state.name} digital ID or mDL to Apple Wallet, Google Wallet, or the ${state.name} state app.`
  }
  schema={stateSchema}
>
  <div class="mx-auto max-w-2xl px-4 py-12">
    <a href="/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-brand-600 transition-colors mb-8">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      All states
    </a>

    <div class="flex flex-wrap items-start justify-between gap-4 mb-2">
      <h1 class="font-serif text-3xl font-semibold text-gray-900">{state.name}</h1>
      <span class={`rounded-full px-3 py-1 text-sm font-medium ${statusClass}`}>
        {statusLabel}
      </span>
    </div>

    {state.notes && (
      <p class="mt-3 mb-8 text-gray-500 text-sm leading-relaxed">{state.notes}</p>
    )}

    {!state.notes && <div class="mb-8"></div>}

    {state.official_url && (
      <a
        href={state.official_url}
        target="_blank"
        rel="noopener noreferrer"
        class="mb-6 inline-flex items-center gap-1.5 text-sm font-medium text-brand-600 hover:underline"
      >
        Official {state.name} digital ID program
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    )}

    {state.mdl_status === 'not_available' ? (
      <div class="space-y-6">
        <div class="rounded-xl border border-gray-100 bg-white p-8">
          <h2 class="font-serif text-xl font-semibold text-gray-900 mb-3">Digital ID isn't available in {state.name} yet.</h2>
          <p class="text-gray-600 leading-relaxed">
            A mobile driver's license (mDL) lets you carry a secure, verified copy of your state ID or driver's license on your phone — accepted at TSA checkpoints and participating businesses. More than 21 US states and territories have already launched programs, but {state.name} hasn't yet.
          </p>
        </div>

        <div class="rounded-xl border border-brand-200 bg-brand-50 p-8">
          <h2 class="font-serif text-xl font-semibold text-gray-900 mb-3">Make your voice heard</h2>
          <p class="text-gray-600 leading-relaxed mb-5">
            Digital ID programs require state legislation and funding — and constituent demand matters. Contact your state legislators and US representatives to let them know that a mobile driver's license program is important to you.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="https://www.congress.gov/members/find-your-member"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700 transition-colors"
            >
              Find your US representatives
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>

        <div class="rounded-xl border border-gray-100 bg-white p-8">
          <h2 class="font-serif text-xl font-semibold text-gray-900 mb-3">Track national progress</h2>
          <p class="text-gray-600 leading-relaxed mb-5">
            The American Association of Motor Vehicle Administrators (AAMVA) maintains the definitive map of mDL program status across all US states and territories.
          </p>
          <a
            href="https://www.aamva.org/jurisdiction-data-maps#anchorformdlmap"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-brand-600 hover:underline"
          >
            View the AAMVA mDL jurisdiction map
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    ) : (
      <div class="space-y-3">
        {state.wallets.map((wallet) => (
          <WalletCard wallet={wallet} />
        ))}
      </div>
    )}

    <p class="mt-8 text-xs text-gray-400 text-right">Last updated: {state.last_updated}</p>
  </div>
</Layout>
