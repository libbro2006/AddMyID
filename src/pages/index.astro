---
import Layout from '../layouts/Layout.astro';
import StateSearch from '../components/StateSearch.astro';
import USAMap from '../components/USAMap.astro';
import { getCollection } from '../utils/states';

const states = await getCollection();
const liveCount = states.filter((s) => s.mdl_status === 'live').length;
const comingCount = states.filter((s) => s.mdl_status === 'coming_soon').length;

const homeSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'AddMyID',
  url: 'https://addmyid.info',
  description: 'Learn how to add your state digital ID, mDL, or digital passport to Apple Wallet, Google Wallet, or your state app.',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://addmyid.info/?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
});
---

<Layout schema={homeSchema}>
  <section class="mx-auto max-w-4xl px-4 pt-16 pb-12 text-center">
    <h1 class="font-serif text-4xl font-semibold leading-tight text-gray-900 sm:text-5xl">
      Add your digital ID<br />to your phone
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-lg text-gray-500 leading-relaxed">
      More than {liveCount} states let you carry your driver license or state ID in Apple Wallet,
      Google Wallet, or a state app — and both Apple and Google Wallet also support US passports.
      Find out what's available where you live.
    </p>
  </section>

  <section class="mx-auto max-w-4xl px-4 pb-16">
    <StateSearch />

  </section>

  <section class="mx-auto max-w-4xl px-4 pb-6">
    <USAMap states={states} />
  </section>

  <section class="mx-auto max-w-4xl px-4 pb-20">
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
      {states.map((state) => (
        <a
          href={`/state/${state.slug}`}
          class={`flex items-center justify-between rounded-xl border px-4 py-3 transition-shadow hover:shadow-sm
            ${state.mdl_status === 'live'
              ? 'border-gray-200 bg-white hover:border-brand-200'
              : 'border-gray-100 bg-white opacity-60 hover:opacity-80'
            }`}
        >
          <span class="font-medium text-gray-800 text-sm">{state.abbreviation}</span>
          <span class={`h-2 w-2 rounded-full ${
            state.mdl_status === 'live'
              ? 'bg-green-400'
              : state.mdl_status === 'coming_soon'
              ? 'bg-amber-400'
              : 'bg-gray-200'
          }`}></span>
        </a>
      ))}
    </div>

    <div class="mt-6 flex justify-center gap-6 text-xs text-gray-400">
      <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-green-400"></span> Available ({liveCount})</span>
      <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-amber-400"></span> Coming soon ({comingCount})</span>
      <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-gray-200"></span> Not available</span>
    </div>
  </section>

  <section class="border-t border-gray-100 bg-white py-16">
    <div class="mx-auto max-w-4xl px-4">
      <h2 class="font-serif text-2xl font-semibold text-gray-900 text-center mb-10">Supported wallets</h2>
      <div class="grid gap-6 sm:grid-cols-3">
        <a href="/guides/apple" class="group rounded-xl border border-gray-200 bg-white p-6 hover:shadow-sm hover:border-brand-200 transition-all">
          <h3 class="font-serif text-lg font-semibold text-gray-900 group-hover:text-brand-600 transition-colors">Apple Wallet</h3>
          <p class="mt-1.5 text-sm text-gray-500">iPhone iOS 15.4+ · State IDs & US passports</p>
        </a>
        <a href="/guides/google" class="group rounded-xl border border-gray-200 bg-white p-6 hover:shadow-sm hover:border-brand-200 transition-all">
          <h3 class="font-serif text-lg font-semibold text-gray-900 group-hover:text-brand-600 transition-colors">Google Wallet</h3>
          <p class="mt-1.5 text-sm text-gray-500">Android 9+ · State IDs & US passports</p>
        </a>
        <a href="/guides/samsung" class="group rounded-xl border border-gray-200 bg-white p-6 hover:shadow-sm hover:border-brand-200 transition-all">
          <h3 class="font-serif text-lg font-semibold text-gray-900 group-hover:text-brand-600 transition-colors">Samsung Wallet</h3>
          <p class="mt-1.5 text-sm text-gray-500">Galaxy devices · One UI 5+</p>
        </a>
      </div>
    </div>
  </section>
</Layout>
