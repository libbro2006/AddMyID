---
import Layout from '../../layouts/Layout.astro';
import platforms from '../../data/platforms.json';

export function getStaticPaths() {
  return platforms.platforms.map((p) => ({
    params: { platform: p.slug },
    props: { platform: p },
  }));
}

const { platform } = Astro.props;
---

<Layout
  title={`${platform.name} — AddMyID`}
  description={platform.tagline}
>
  <div class="mx-auto max-w-2xl px-4 py-12">
    <a href="/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-brand-600 transition-colors mb-8">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      Home
    </a>

    <p class="text-sm font-semibold uppercase tracking-widest text-brand-500 mb-2">Wallet guide</p>
    <h1 class="font-serif text-3xl font-semibold text-gray-900 mb-3">{platform.name}</h1>
    <p class="text-gray-500 leading-relaxed mb-10">{platform.description}</p>

    <div class="space-y-8">
      <section>
        <h2 class="font-serif text-xl font-semibold text-gray-900 mb-4">What you can add</h2>
        <ul class="space-y-2">
          {platform.supported_documents.map((doc) => (
            <li class="flex items-center gap-2 text-sm text-gray-700">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>
              {doc}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="font-serif text-xl font-semibold text-gray-900 mb-4">What you need</h2>
        <ul class="space-y-2">
          {platform.requirements.map((req) => (
            <li class="flex items-center gap-2 text-sm text-gray-700">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>
              {req}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="font-serif text-xl font-semibold text-gray-900 mb-4">General setup steps</h2>
        <ol class="space-y-4">
          {platform.general_steps.map((step, i) => (
            <li class="flex gap-4 text-sm text-gray-700">
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-50 text-xs font-semibold text-brand-600">
                {i + 1}
              </span>
              <span class="leading-relaxed pt-0.5">{step}</span>
            </li>
          ))}
        </ol>
      </section>

      <section>
        <h2 class="font-serif text-xl font-semibold text-gray-900 mb-3">Accepted where?</h2>
        <p class="text-sm text-gray-600 leading-relaxed">{platform.accepted_where}</p>
      </section>

      <a
        href={platform.official_url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-xl bg-brand-500 px-5 py-3 text-sm font-semibold text-white hover:bg-brand-600 transition-colors"
      >
        Official {platform.name} support page
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>

    <div class="mt-12 rounded-xl border border-gray-100 bg-white p-6">
      <p class="text-sm font-semibold text-gray-700 mb-3">Looking for your state's specific instructions?</p>
      <a href="/" class="text-sm text-brand-600 hover:underline">Find your state &rarr;</a>
    </div>
  </div>
</Layout>
