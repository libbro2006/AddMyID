---
interface Wallet {
  id: string;
  name: string;
  available: boolean;
  coming_soon: boolean;
  official_url?: string;
  app_name?: string;
  app_store_url?: string;
  play_store_url?: string;
  steps?: string[];
}

interface Props {
  wallet: Wallet;
}

const { wallet } = Astro.props;

const statusLabel = wallet.available
  ? 'Available'
  : wallet.coming_soon
  ? 'Coming soon'
  : 'Not available';

const statusClass = wallet.available
  ? 'bg-green-50 text-green-700 border border-green-200'
  : wallet.coming_soon
  ? 'bg-amber-50 text-amber-700 border border-amber-200'
  : 'bg-gray-50 text-gray-400 border border-gray-200';

const hasContent = wallet.available && wallet.steps && wallet.steps.length > 0;
---

<div class={`rounded-xl border bg-white overflow-hidden transition-shadow ${wallet.available ? 'border-gray-200 hover:shadow-sm' : 'border-gray-100 opacity-70'}`}>
  {hasContent ? (
    <details class="group">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5">
        <div class="flex items-center gap-3">
          <span class="text-base font-semibold text-gray-800">{wallet.name}</span>
          <span class={`rounded-full px-2.5 py-0.5 text-xs font-medium ${statusClass}`}>
            {statusLabel}
          </span>
        </div>
        <svg
          class="h-4 w-4 text-gray-400 transition-transform group-open:rotate-180 shrink-0"
          fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>

      <div class="border-t border-gray-100 px-5 pb-5 pt-4">
        <ol class="space-y-3 text-sm text-gray-700">
          {wallet.steps!.map((step, i) => (
            <li class="flex gap-3">
              <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-50 text-xs font-semibold text-brand-600">
                {i + 1}
              </span>
              <span>{step}</span>
            </li>
          ))}
        </ol>

        <div class="mt-5 flex flex-wrap gap-2">
          {wallet.official_url && (
            <a
              href={wallet.official_url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-lg border border-brand-500 px-3 py-1.5 text-xs font-medium text-brand-600 hover:bg-brand-50 transition-colors"
            >
              Official instructions
              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          )}
          {wallet.app_store_url && (
            <a
              href={wallet.app_store_url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-gray-50 transition-colors"
            >
              App Store
            </a>
          )}
          {wallet.play_store_url && (
            <a
              href={wallet.play_store_url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-gray-50 transition-colors"
            >
              Google Play
            </a>
          )}
        </div>
      </div>
    </details>
  ) : (
    <div class="flex items-center justify-between gap-4 p-5">
      <div class="flex items-center gap-3">
        <span class="text-base font-semibold text-gray-500">{wallet.name}</span>
        <span class={`rounded-full px-2.5 py-0.5 text-xs font-medium ${statusClass}`}>
          {statusLabel}
        </span>
      </div>
      {wallet.official_url && wallet.coming_soon && (
        <a
          href={wallet.official_url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-brand-600 hover:underline"
        >
          Learn more
        </a>
      )}
    </div>
  )}
</div>
